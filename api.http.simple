# REST

## 1. Admin
# 1.1 Login (Admin)
POST http://localhost:9092/admin/login
Content-Type: application/json

{
    "email": "",
    "password": "",
    "rememberMe": false
}

### 1.2 Register (Admin) one time for first time to create admin account
POST http://localhost:9092/admin/register-admin
Content-Type: application/json

{
    "firstname": "",
    "lastname": "",
    "email": "",
    "password": ""
}

### 1.3 Forgot Password
# Response: {"ok":true,"code":"<reset_code>"} — นำ code ไปใส่ใน 1.4
POST http://localhost:9092/admin/forgot-password
Content-Type: application/json

{
    "email": ""
}

### 1.4 Reset Password (Admin)
# เอา code จาก response 1.3 ไปใส่ที่ resetPasswordToken
POST http://localhost:9092/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "",
    "password": ""
}

### 1.5 Profile
GET http://localhost:9092/admin/users/me
Authorization: Bearer {YOUR_JWT_TOKEN}

## 2.User
### 2.1 Login
POST http://localhost:9092/api/auth/local
Content-Type: application/json

{
    "identifier": "",
    "password": ""
}

### 2.2 Register
POST http://localhost:9092/api/auth/local/register
Content-Type: application/json

{
    "username": "",
    "email": "",
    "password": ""
}

### 2.3 Forgot Password
# Response: {"ok":true,"code":"<reset_code>"} — นำ code ไปใส่ใน 2.3.1
POST http://localhost:9092/api/auth/forgot-password
Content-Type: application/json

{
    "email": ""
}

### 2.3.1 Reset Password
# เอา code จาก response 2.3 ไปใส่ที่ code
POST http://localhost:9092/api/auth/reset-password
Content-Type: application/json

{
    "code": "",
    "password": "",
    "passwordConfirmation": ""
}

### 2.4 Profile
GET http://localhost:9092/api/users/me
Authorization: Bearer {YOUR_JWT_TOKEN}